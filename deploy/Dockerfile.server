FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY sim/package.json sim/package.json
COPY server/package.json server/package.json
COPY tma/package.json tma/package.json
COPY content/package.json content/package.json
COPY sim sim
COPY server server
COPY tma tma
COPY content content
RUN npm ci
RUN npm run build -w @legion/server

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
COPY sim/package.json sim/package.json
COPY server/package.json server/package.json
COPY tma/package.json tma/package.json
COPY content/package.json content/package.json
RUN npm ci -w @legion/server --include-workspace-root --omit=dev
COPY --from=build /app/server/dist server/dist
EXPOSE 2567
CMD ["node", "server/dist/index.js"]
