FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY sim/package.json sim/package.json
COPY server/package.json server/package.json
COPY tma/package.json tma/package.json
COPY content/package.json content/package.json
COPY sim sim
COPY server server
COPY tma tma
COPY content content
RUN npm ci
RUN npm run build -w @legion/tma

FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/tma/dist /srv
